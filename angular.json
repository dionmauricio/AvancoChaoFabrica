{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "avanco-chao-fabrica": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/web",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/web/main.ts",
            "index": "src/web/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/web/styles.css"],
            "assets": ["src/web/assets"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "src/web/proxy.conf.json",
            "host": "0.0.0.0",
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "avanco-chao-fabrica:build:production"
            },
            "development": {
              "buildTarget": "avanco-chao-fabrica:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
