# Copie este arquivo para .env e informe a senha local do PostgreSQL.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=avanco;Username=postgres;Password=COLOQUE_SUA_SENHA_AQUI
Authentication__Mode=Local
Authentication__Issuer=AvancoChaoFabrica.Local
Authentication__Audience=avanco-api
# Gere uma chave aleatória privada com pelo menos 32 bytes; não reutilize o exemplo.
Authentication__SigningKey=GERE_UMA_CHAVE_ALEATORIA_FORTE_DE_PELO_MENOS_32_BYTES
# Bootstrap apenas na primeira execução; use senha forte e remova estas duas entradas depois.
BootstrapAdmin__UserName=admin
BootstrapAdmin__Password=DEFINA_UMA_SENHA_FORTE_COM_PELO_MENOS_12_CARACTERES
# Para frontend em outra origem, adicione cada origem exata permitida, por exemplo:
# Cors__AllowedOrigins__0=https://avanco.suaempresa.local
# Para OIDC futuro, substitua o modo Local e configure Authority/Audience no backend.
# Authentication__Mode=OpenIdConnect
# Authentication__Authority=https://identity.suaempresa.com/tenant/v2.0
# Authentication__Audience=api://avanco
